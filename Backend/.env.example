# ============================================================
# NagarSewa — Backend Environment
# ============================================================

# HTTP port the API listens on
PORT=2026

# ---- Database ----
# Option A — Local Postgres (individual variables):
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=NagarSewa
PG_USER=postgres
PG_PASSWORD=your_database_password_here
# Set to "true" only if your local Postgres requires SSL (usually false)
PG_SSL=false

# Option B — Hosted Postgres (Neon / Render): a full connection string.
# When set, this OVERRIDES the PG_* vars above and connects over SSL.
# Example: postgresql://user:pass@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# ---- Environment ----
# Use "production" on the deployed server; leave as "development" locally.
NODE_ENV=development
