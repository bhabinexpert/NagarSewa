# ============================================================
# NagarSewa Backend Environment Configuration
# ============================================================
# 
# IMPORTANT: 
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit the .env file to version control
# 3. Change all passwords and secrets in production
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=2026

# Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=NagarSewa
PG_USER=postgres
PG_PASSWORD=your_database_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_characters
JWT_EXPIRES_IN=24h

# Super Admin Credentials
# WARNING: Change these immediately in production!
SUPER_ADMIN_EMAIL=superadmin@damak.gov.np
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password_here

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# ============================================================
# Production Deployment Checklist:
# ============================================================
# [ ] Set NODE_ENV=production
# [ ] Change JWT_SECRET to a strong random string (32+ chars)
# [ ] Change SUPER_ADMIN_PASSWORD to a strong password
# [ ] Update PG_PASSWORD with production database password
# [ ] Set FRONTEND_URL to production domain
# [ ] Ensure .env is in .gitignore
# [ ] Use environment variable management (AWS Secrets, etc.)
# ============================================================
